exports[`when mid year 1`] = `
<div>
  <svg
    class="clock"
    preserveAspectRatio="xMidYMid meet"
    viewBox="-500 -500 1000 1000"
  >
    <defs>
      <lineargradient
        id="month-gradient"
        x1="0"
        x2="0"
        y1="0"
        y2="1"
      >
        <stop
          offset="0%"
          stop-color="gray"
        />
        <stop
          offset="100%"
          stop-color="white"
          stop-opacity="0"
